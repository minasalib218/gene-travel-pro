  `}function eo({colorScheme:e,themeDark:t,themeLight:r,styleNonce:n}){let i=x.createElement("style");return i.textContent=`
:host {
  --font-family: system-ui, 'Helvetica Neue', Arial, sans-serif;
  --font-size: 14px;
  --z-index: 100000;

  --page-margin: 16px;
